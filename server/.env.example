# MyAnimeList OAuth credentials (secret!) — never commit this file.
# Copy to server/.env and fill in. The client secret must stay server-side.
MAL_CLIENT_ID=your_mal_client_id
MAL_CLIENT_SECRET=your_mal_client_secret
# Long random string used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_long_random_string

# Where MAL redirects back to after the user authorizes. Must be EXACTLY ONE
# absolute http(s) URL (never two URLs joined with a comma) and must match a
# redirect URL registered in the MAL app config.
#   Local dev:  http://localhost:3000/api/auth/callback/mal
#   Home server: http://192.168.0.193:3000/api/auth/callback/mal
MAL_REDIRECT_URI=http://localhost:3000/api/auth/callback/mal

# CORS: comma-separated origins allowed to call the API from a browser.
# In production, replace with your deployed frontend origin (e.g. https://captureordie.com).
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Where the frontend lives — the browser is redirected here (profile#mal=connected)
# AFTER a successful token exchange. Never merge this into MAL_REDIRECT_URI.
#   Local dev:  http://localhost:8080
#   Netlify:    https://capture-anime.netlify.app
# FRONTEND_URL=http://localhost:8080

# Production: serve the built frontend statically from this folder (optional).
# STATIC_DIR=../dist
PORT=3000

# Where the frontend lives — the browser is redirected here after a successful
# MAL link (e.g. https://capture-anime.netlify.app). Defaults to CORS_ORIGINS[0].
# FRONTEND_URL=http://localhost:8080
